# Environment variables for RoomMatch deployment
# Copy this to .env and fill in your values

# Flask configuration
SECRET_KEY=<your-secret-key-here>
COOKIE_SECURE=1  # Set to 1 when behind HTTPS

# Database
DB_PATH=/data/roommatch.db  # Path to SQLite database (use persistent storage for production)

# Twilio WhatsApp configuration
TWILIO_ACCOUNT_SID=<your-twilio-account-sid>
TWILIO_AUTH_TOKEN=<your-twilio-auth-token>
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886  # Your Twilio WhatsApp number